# ============================================================
# TODO (tiêu chí 9): liệt kê ĐỦ các biến môi trường app cần, KHÔNG ghi secret thật.
#   Bắt buộc có: AGENT_API_KEY, REDIS_URL, RATE_LIMIT_PER_MINUTE,
#                DAILY_BUDGET_USD (hoặc MONTHLY_BUDGET_USD)
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# ============================================================
PORT=8000
ENVIRONMENT=development
AGENT_API_KEY=replace-with-a-local-secret
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
